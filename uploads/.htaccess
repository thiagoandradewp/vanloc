# Uploads são apenas imagens: nunca executar scripts aqui
Options -Indexes
<FilesMatch "\.(php\d?|phtml|phar|pl|py|cgi|sh|html?)$">
    Require all denied
</FilesMatch>
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8
RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8
